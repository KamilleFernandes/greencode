{
  "name": "greencode-av2-api",
  "version": "2.0.0",
  "private": true,
  "description": "GreenCode - API REST para logística reversa, AV2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node out/server.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "node scripts/test.cjs",
    "test:unit": "npm run generate && tsx --test tests/unit.test.ts",
    "predev": "npm run seed",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
