{
  "name": "greencode",
  "version": "1.0.0",
  "description": "Sistema CLI para logística reversa de equipamentos eletrônicos",
  "main": "out/cli/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node out/cli/index.js",
    "test:jornada": "npm run build && node --test testes/jornada-completa.test.js",
    "test:detalhes": "npm run build && node --test testes/cenarios-falha.test.js",
    "test": "npm run build && node --test testes/jornada-completa.test.js testes/cenarios-falha.test.js testes/regressoes.test.js",
    "test:regressoes": "npm run build && node --test testes/regressoes.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  }
}
