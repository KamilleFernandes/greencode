# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# ---------- Banco de dados (PostgreSQL) ----------
DATABASE_URL=postgresql://greencode:troque-sua-senha@localhost:5432/greencode
# Banco EXCLUSIVO dos testes automatizados: o nome precisa conter "test" (o script recusa qualquer outro).
TEST_DATABASE_URL=postgresql://greencode:troque-sua-senha@localhost:5432/greencode_test

# ---------- Autenticação ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-bytes
JWT_EXPIRES_IN=30m
BCRYPT_ROUNDS=12

# ---------- Auditoria (journal) ----------
# Retenção mínima em dias e tamanho (bytes) a partir do qual o journal é rotacionado (10 MB).
AUDITORIA_RETENCAO_DIAS=180
AUDITORIA_LIMITE_BYTES=10485760
