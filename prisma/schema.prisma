generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Organizacao {
  id                 String    @id @default(uuid()) @db.Uuid
  codigo             String    @unique @db.VarChar(12)
  razaoSocial        String    @db.VarChar(180)
  cnpj               String    @unique @db.VarChar(14)
  inscricaoEstadual  String    @db.VarChar(30)
  enderecoCompleto   String    @db.VarChar(300)
  telefone           String    @db.VarChar(30)
  email              String    @db.VarChar(160)
  dataCadastro       DateTime  @default(now())
  ativo              Boolean   @default(true)
  versao             Int       @default(1)
  contrato           Contrato?
  lotes              Lote[]

  @@index([ativo])
  @@map("organizacoes")
}

model Contrato {
  id                 String      @id @default(uuid()) @db.Uuid
  codigo             String      @unique @db.VarChar(12)
  organizacaoId      String      @unique @db.Uuid
  dataAssinatura     DateTime    @db.Date
  dataVencimento     DateTime    @db.Date
  clausulas          String[]    @default([])
  valorMensal        Decimal     @db.Decimal(12, 2)
  renovacaoAutomatica Boolean    @default(false)
  versao             Int         @default(1)
  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@index([dataVencimento])
  @@map("contratos")
}

model Lote {
  id                 String         @id @default(uuid()) @db.Uuid
  codigo             String         @unique @db.VarChar(12)
  dataEntrada        DateTime       @db.Date
  organizacaoId      String         @db.Uuid
  notaFiscal         String         @db.VarChar(80)
  transportadora     String         @db.VarChar(160)
  observacoes        String         @default("") @db.VarChar(1000)
  statusProcessamento StatusLote    @default(RECEBIDO)
  versao             Int            @default(1)
  organizacao        Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos       Equipamento[]
  criadoEm           DateTime       @default(now())

  @@index([organizacaoId])
  @@index([statusProcessamento])
  @@index([dataEntrada])
  @@map("lotes")
}

model Equipamento {
  id                 String             @id @default(uuid()) @db.Uuid
  codigo             String             @unique @db.VarChar(12)
  codigoBarrasInterno String?            @unique @db.VarChar(32)
  tipo               TipoEquipamento
  marca              String             @db.VarChar(100)
  modelo             String             @db.VarChar(120)
  anoFabricacao      Int
  estadoFisico       EstadoFisico       @default(NOVO)
  pesoQuilogramas    Decimal            @db.Decimal(10, 3)
  loteId             String             @db.Uuid
  posicaoNoLote      Int
  statusRastreamento StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao             Int                @default(1)
  criadoEm           DateTime           @default(now())
  lote               Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimentacoes      Movimentacao[]

  @@unique([loteId, posicaoNoLote])
  @@index([loteId])
  @@index([statusRastreamento])
  @@index([estadoFisico])
  @@map("equipamentos")
}

model Movimentacao {
  id             String      @id @default(uuid()) @db.Uuid
  equipamentoId  String      @db.Uuid
  dataHora       DateTime    @default(now())
  origem         String      @db.VarChar(40)
  destino        String      @db.VarChar(40)
  responsavel    String      @db.VarChar(80)
  observacao     String      @default("") @db.VarChar(1000)
  versao         Int         @default(1)
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@index([equipamentoId, dataHora])
  @@index([dataHora])
  @@map("movimentacoes")
}

model Usuario {
  id             String       @id @default(uuid()) @db.Uuid
  login          String       @unique @db.VarChar(32)
  nome           String       @db.VarChar(120)
  hashSenha      String       @db.VarChar(255)
  papel          PapelUsuario
  ativo          Boolean      @default(true)
  ultimoAcesso   DateTime?
  versao         Int          @default(1)
  criadoEm       DateTime     @default(now())

  @@index([papel])
  @@index([ativo])
  @@map("usuarios")
}

model ConfiguracaoGlobal {
  id                       String   @id @default("global") @db.VarChar(20)
  aliquotaImposto          Decimal  @default(0) @db.Decimal(5, 4)
  coeficienteDepreciacaoPadrao Decimal @default(0.1) @db.Decimal(5, 4)
  coeficientesDepreciacao  Json     @default("{}")
  versao                   Int      @default(1)
  atualizadoEm             DateTime @default(now()) @updatedAt

  @@map("configuracoes_globais")
}

/// Journal de transações (formato da AV1/UML JournalTransacao): id, timestamp, operacao, entidade,
/// dadosAntes, dadosDepois e usuarioResponsavel, acrescido dos metadados da requisição HTTP.
/// Somente inclusão (trigger). Retenção mínima de 180 dias; rotação para auditorias_arquivadas acima de 10 MB.
model Auditoria {
  id                 String   @id @default(uuid()) @db.Uuid
  timestamp          DateTime @default(now())
  operacao           String   @db.VarChar(80)
  entidade           String   @db.VarChar(80)
  entidadeId         String?  @db.VarChar(80)
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String   @db.VarChar(32)
  usuarioId          String?  @db.Uuid
  requisicaoId       String?  @db.VarChar(64)
  metodo             String?  @db.VarChar(10)
  rota               String?  @db.VarChar(200)
  ip                 String?  @db.VarChar(64)
  statusHttp         Int?
  versao             Int      @default(1)

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([operacao])
  @@index([timestamp])
  @@map("auditorias")
}

/// Destino da rotação do journal (mesma estrutura de Auditoria).
model AuditoriaArquivada {
  id                 String   @id @db.Uuid
  timestamp          DateTime
  operacao           String   @db.VarChar(80)
  entidade           String   @db.VarChar(80)
  entidadeId         String?  @db.VarChar(80)
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String   @db.VarChar(32)
  usuarioId          String?  @db.Uuid
  requisicaoId       String?  @db.VarChar(64)
  metodo             String?  @db.VarChar(10)
  rota               String?  @db.VarChar(200)
  ip                 String?  @db.VarChar(64)
  statusHttp         Int?
  versao             Int      @default(1)
  arquivadoEm        DateTime @default(now())

  @@index([timestamp])
  @@index([entidade, entidadeId])
  @@map("auditorias_arquivadas")
}
